#!/usr/bin/env bash
# ScreenSolver launcher / trigger.
#
#   screensolver [solve|toggle|dismiss|copy|status|answer]   (default: solve)
#   screensolver daemon                                       start in foreground
#
# Starts the Quickshell daemon on demand, then forwards the command over IPC.
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
QS=(qs -p "$DIR")
cmd="${1:-solve}"

if [ "$cmd" = daemon ]; then
    exec "${QS[@]}"
fi

if ! "${QS[@]}" ipc show >/dev/null 2>&1; then
    "${QS[@]}" -d >/dev/null 2>&1
    for _ in $(seq 50); do
        "${QS[@]}" ipc show >/dev/null 2>&1 && break
        sleep 0.1
    done
fi

exec "${QS[@]}" ipc call solver "$cmd"
